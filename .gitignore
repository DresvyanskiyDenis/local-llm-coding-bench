# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Eval scratch — per-run working copies are regenerable and huge; only eval/results/ is tracked
eval/runs/
eval/runs_corrupted_night3/
eval/results_corrupted_night3/

# Operational logs (may contain endpoint keys) — never track
eval/results/logs/
*.log

# OS / editor
.DS_Store
.idea/
.vscode/

# Local model weights / caches — never commit multi-GB GGUFs
*.gguf

# MkDocs build output
site/
.cache/

# Round 2 — external benchmark scratch (venvs, generations, downloaded corpora)
eval/external/*/.venv/
eval/external/*/_work/
eval/external/*/nltk_data/
eval/external/bigcodebench/_gen/

# Which serving stack owns :8888 right now (ops/serving_mode.sh) — machine state, not repo state
eval/harness/ops/.serving_mode

# eval_proxy.py's per-request override ledger (append-only, regenerated every run)
eval/harness/eval_proxy.jsonl

# reasoning_leak_probe.py scratch (serve log + proxy ledger); the probe RESULT
# eval/external/reasoning_leak_probe.json is evidence and IS tracked
eval/harness/ops/.probe_*
