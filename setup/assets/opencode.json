{
  "$schema": "https://opencode.ai/config.json",
  "model": "unsloth-studio/unsloth/Qwen3.6-35B-A3B-MTP-GGUF",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "plugin": [
    "@tarquinen/opencode-dcp@3.1.14",
    "@slkiser/opencode-quota@3.10.1"
  ],
  "tools": {
    "codesearch": true,
    "todowrite": true,
    "question": true
  },
  "disabled_providers": [
    "anthropic",
    "google"
  ],
  "provider": {
    "litellm-next": {
      "models": {
        "gpt-5.4": {
          "name": "GPT-5.4"
        },
        "gpt-5.5": {
          "name": "GPT-5.5",
          "reasoning": true,
          "options": {
            "reasoningEffort": "high"
          }
        }
      },
      "name": "LiteLLM (example gateway)",
      "npm": "@ai-sdk/openai",
      "env": [
        "LITELLM_API_KEY"
      ],
      "options": {
        "apiKey": "{env:LITELLM_API_KEY}",
        "baseURL": "https://your-litellm-gateway.example.com/v1"
      }
    },
    "github-copilot": {
      "options": {
        "enterpriseUrl": "https://your-enterprise-github.example.com"
      }
    },
    "deepseek": {
      "name": "DeepSeek",
      "npm": "@ai-sdk/openai-compatible",
      "env": [
        "DEEPSEEK_API_KEY"
      ],
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}",
        "baseURL": "https://api.deepseek.com/v1"
      },
      "models": {
        "deepseek-chat": {
          "name": "DeepSeek V3 Chat"
        },
        "deepseek-reasoner": {
          "name": "DeepSeek R1 Reasoner"
        }
      }
    },
    "unsloth-studio": {
      "name": "Unsloth Studio",
      "npm": "@ai-sdk/openai-compatible",
      "env": [
        "UNSLOTH_STUDIO_API_KEY"
      ],
      "options": {
        "baseURL": "http://127.0.0.1:8888/v1",
        "apiKey": "{env:UNSLOTH_STUDIO_API_KEY}",
        "chunkTimeout": 120000,
        "headerTimeout": 300000,
        "timeout": 1800000
      },
      "models": {
        "unsloth/Qwen3.6-35B-A3B-MTP-GGUF": {
          "name": "Qwen3.6 35B A3B MTP (thinking)",
          "reasoning": true,
          "limit": {
            "context": 90000,
            "output": 8192
          }
        },
        "hesamation/Qwen3.6-35B-A3B-Claude-4.6-Opus-Reasoning-Distilled-GGUF": {
          "name": "Qwen3.6 Opus-4.6 distill (Q5_K_M)",
          "reasoning": true,
          "limit": {
            "context": 90000,
            "output": 8192
          }
        },
        "gpt-oss-20b": {
          "name": "gpt-oss-20b (MXFP4)",
          "reasoning": true,
          "options": {
            "reasoningEffort": "high"
          },
          "limit": {
            "context": 90000,
            "output": 8192
          }
        },
        "unsloth/North-Mini-Code-1.0-GGUF": {
          "name": "North Mini Code 1.0 (UD-Q5_K_XL, agentic)",
          "limit": {
            "context": 90000,
            "output": 8192
          }
        },
        "unsloth/GLM-4.7-Flash-GGUF": {
          "name": "GLM-4.7-Flash (UD-Q5_K_XL, non-MTP, 64K window)",
          "reasoning": true,
          "limit": {
            "context": 60000,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true,
      "environment": {
        "NODE_EXTRA_CA_CERTS": "{env:HOME}/.ssl/allCAbundle.pem"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.41",
        "--headless"
      ],
      "enabled": false
    },
    "firecrawl": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "firecrawl-mcp"
      ],
      "enabled": false,
      "environment": {
        "FIRECRAWL_API_KEY": "{env:FIRECRAWL_API_KEY}",
        "NODE_EXTRA_CA_CERTS": "{env:HOME}/.ssl/allCAbundle.pem"
      }
    },
    "atlassian": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-atlassian",
        "--env-file",
        "{env:HOME}/.atlassian/.env",
        "--toolsets",
        "default,jira_links,jira_agile,jira_users,confluence_users"
      ],
      "enabled": false
    }
  },
  "permission": {
    "bash": {
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git branch *": "allow",
      "git show *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git pull *": "allow",
      "git fetch *": "allow",
      "gh *": "allow",
      "gh copilot *": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "uv *": "allow",
      "uvx *": "allow",
      "curl *": "allow",
      "python3 -m json.tool *": "allow",
      "python3 -c *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "poetry *": "allow",
      ".venv/bin/python *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "date *": "allow",
      "rm -rf *": "deny",
      "rm -rf /": "deny",
      "rm -rf ~": "deny",
      "rm -r / *": "deny",
      "sudo rm *": "deny",
      "sudo *": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git reset --hard *": "deny",
      "git branch -D *": "deny",
      "git clean -fd *": "deny",
      "git checkout -- .": "deny",
      "chmod 777 *": "deny",
      "pkill -9 *": "deny",
      "killall *": "deny",
      "mkfs.*": "deny",
      "mkfs *": "deny",
      "dd *of=/dev/sd*": "deny",
      "dd *of=/dev/nvme*": "deny",
      "dd *of=/dev/disk*": "deny",
      "shutdown *": "deny",
      "shutdown": "deny",
      "curl * | bash*": "deny",
      "curl * | sh*": "deny",
      "curl * | zsh*": "deny",
      "curl * | sudo bash*": "deny",
      "curl * | sudo sh*": "deny",
      "wget * | bash*": "deny",
      "wget * | sh*": "deny",
      "wget * | zsh*": "deny",
      "wget * | sudo bash*": "deny",
      "wget * | sudo sh*": "deny",
      ":(){ *": "deny"
    },
    "read": {
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.env.example": "allow",
      "**/.env.template": "allow",
      "**/.env.sample": "allow",
      "**/.env.local.example": "allow",
      "**/secrets/**": "deny",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "**/id_rsa": "deny",
      "**/id_rsa.*": "deny",
      "**/id_ed25519": "deny",
      "**/id_ed25519.*": "deny",
      "**/id_ecdsa": "deny",
      "**/id_ecdsa.*": "deny",
      "**/*.pem": "deny",
      "**/*.p12": "deny",
      "**/credentials.json": "deny",
      "**/copilot-quota-token.json": "deny",
      "**/*quota-token.json": "deny",
      "**/.claude/.credentials*": "deny",
      "**/*.session": "deny",
      "**/.aws/credentials": "deny"
    },
    "edit": "allow",
    "write": {
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.env.example": "allow",
      "**/.env.template": "allow",
      "**/.env.sample": "allow",
      "**/.env.local.example": "allow",
      "**/secrets/**": "deny",
      "**/id_rsa": "deny",
      "**/id_rsa.*": "deny",
      "**/id_ed25519": "deny",
      "**/id_ed25519.*": "deny",
      "**/id_ecdsa": "deny",
      "**/id_ecdsa.*": "deny",
      "**/*.pem": "deny",
      "**/*.p12": "deny",
      "**/credentials.json": "deny",
      "**/copilot-quota-token.json": "deny",
      "**/*quota-token.json": "deny",
      "**/.claude/.credentials*": "deny",
      "**/*.session": "deny",
      "**/.aws/credentials": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": {
      "*": "allow"
    }
  }
}
