<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Autostart the default (qwen) local model on login.
     RunAtLoad=true  -> starts at login.
     KeepAlive=false -> does NOT respawn if you Ctrl-C it (one model at a time).
     __HOME__ is replaced with your real home directory by install.sh. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.unsloth-studio</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/bin/unsloth-serve</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__HOME__/.unsloth/studio/logs/launchagent.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.unsloth/studio/logs/launchagent.log</string>
</dict>
</plist>
