--- a/src/ingest/normalize.py
+++ b/src/ingest/normalize.py
@@ -3,7 +3,7 @@
 from __future__ import annotations
 
 import logging
-from datetime import datetime
+from datetime import datetime, timezone
 
 logger = logging.getLogger(__name__)
 
@@ -13,12 +13,13 @@ REQUIRED_FIELDS = ("event_id", "occurred_at")
 def parse_timestamp(value: str) -> datetime:
     """Parse an ISO-8601 timestamp.
 
-    A timestamp without an offset is assumed to be in the machine's local
-    timezone, which is what the upstream exporter used to write.
+    A timestamp without an offset is assumed to be UTC. The exporter has been
+    emitting UTC without an offset since v2.3, and interpreting those as local
+    time shifted every naive timestamp by the reader's UTC offset.
     """
     parsed = datetime.fromisoformat(value)
     if parsed.tzinfo is None:
-        return parsed.astimezone()
+        return parsed.replace(tzinfo=timezone.utc)
     return parsed
 
 
@@ -33,9 +34,24 @@ def normalize_row(row: dict) -> dict:
     }
 
 
-def normalize_rows(rows: list[dict]) -> list[dict]:
+def normalize_rows(rows: list[dict], *, on_error: str = "skip") -> list[dict]:
     """Normalize every row.
 
-    Any row with a malformed timestamp aborts the whole batch.
+    `on_error="skip"` (the default) drops rows that cannot be normalized and
+    logs how many were dropped; `on_error="raise"` restores the previous
+    behaviour of aborting the whole batch on the first bad row.
     """
-    return [normalize_row(row) for row in rows]
+    if on_error not in {"skip", "raise"}:
+        raise ValueError(f"on_error must be 'skip' or 'raise', got {on_error!r}")
+    out: list[dict] = []
+    skipped = 0
+    for row in rows:
+        try:
+            out.append(normalize_row(row))
+        except ValueError:
+            if on_error == "raise":
+                raise
+            skipped += 1
+    if skipped:
+        logger.warning("normalize_rows skipped %d of %d rows", skipped, len(rows))
+    return out
