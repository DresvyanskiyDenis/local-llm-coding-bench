<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Raise the Apple-Silicon GPU wired-memory cap at boot, persistently.
     Runs as root (system LaunchDaemon). install.sh fills in __WIRED_LIMIT_MB__
     as (detected unified memory - 4 GB), so ~4 GB always stays free for macOS
     + OpenCode. DO NOT hand-edit this to push closer to the machine's total —
     it starves the OS and triggers the exact swap-death this is meant to prevent.
     Installed to /Library/LaunchDaemons/ (needs sudo). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.unsloth.iogpu-wired-limit</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/sbin/sysctl</string>
        <string>iogpu.wired_limit_mb=__WIRED_LIMIT_MB__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/var/log/iogpu-wired-limit.log</string>
</dict>
</plist>
